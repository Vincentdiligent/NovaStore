<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core network access for repository metadata and artifact downloads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Passwordless Google login: list the Google accounts registered
         on this device via AccountManager. Normal (auto-granted)
         permission since API 26; no password is ever read. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Standard installation backend (prompt #115): the system install
         confirmation flow is never bypassed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required since Android 9 for ACTION_DELETE / PackageInstaller.uninstall:
         without it the system uninstaller silently ignores the request. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Notifications for updates/downloads/installation results.
         Runtime permission is requested only when the user enables
         notifications (prompt #113). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Queue recovery after reboot (prompt #69) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Long-running background downloads via WorkManager foreground worker -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Package visibility: Nova Store's core function is managing all
      installed applications. QUERY_ALL_PACKAGES is the minimal viable
      declaration for an app manager / updater and is permitted for this
      app category. See docs/security.md.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- All-files access (optional, requested once at first launch): lets Nova
         Store read/write the shared storage, e.g. for keeping APK copies in
         the public Downloads folder and staging OBB expansion files. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Package visibility for launching other apps (open app / app info
         from the installed list). QUERY_ALL_PACKAGES covers the rest. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NovaStoreApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaStore">

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open in store" buttons on websites and in apps (market://). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="market" android:host="details" />
                <data android:scheme="market" android:host="search" />
            </intent-filter>

            <!-- Google Play web links. The user can make Nova the default for
                 them in Settings → "Open Play links in Nova Store". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="play.google.com" />
                <data android:pathPrefix="/store/apps/details" />
            </intent-filter>

            <!-- F-Droid / IzzyOnDroid app pages. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="f-droid.org" />
                <data android:host="www.f-droid.org" />
                <data android:host="apt.izzysoft.de" />
                <data android:pathPattern="/.*packages/.*" />
                <data android:pathPattern="/packages/.*" />
                <data android:pathPattern="/fdroid/index/apk/.*" />
            </intent-filter>

            <!-- "Share" a store link to Nova Store. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- QR scanner screen follows the device orientation. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- WorkManager is initialized on demand with the Hilt worker factory
             (NovaStoreApp implements Configuration.Provider). The default
             startup initializer would create it FIRST with the plain factory,
             and @HiltWorker workers (the background update scan) could then
             never be instantiated. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name="com.novastore.app.core.installer.InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.novastore.app.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
