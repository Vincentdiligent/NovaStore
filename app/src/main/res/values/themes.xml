<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AppCompat parent is required for per-app locales backport
         (AppCompatDelegate.setApplicationLocales) and works fine under
         Compose (nothing of the classic widget hierarchy is used). -->
    <style name="Theme.NovaStore" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
